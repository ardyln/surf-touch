+/* ---- dark mode follows the desktop (GNOME/Phosh color-scheme) ---- */
+
+static GSettings *ifacesettings;
+
+static void
+colorschemechanged(GSettings *gs, const char *key, gpointer unused)
+{
+	Client *c;
+	int i;
+	char *v = g_settings_get_string(gs, "color-scheme");
+
+	defconfig[DarkMode].val.i = !strcmp(v, "prefer-dark");
+	g_free(v);
+	/* per-uri parameter sets that don't set DarkMode carry the default */
+	for (i = 0; i < LENGTH(uriparams); ++i)
+		if (uriparams[i].config[DarkMode].prio <= defconfig[DarkMode].prio)
+			uriparams[i].config[DarkMode] = defconfig[DarkMode];
+	/* the GTK setting is per process: one client is enough, but keep the
+	 * parameter bookkeeping of every window right */
+	for (c = clients; c; c = c->next)
+		setparameter(c, 0, DarkMode, &defconfig[DarkMode].val);
+}
+
+void
+darkfollow(void)
+{
+	GSettingsSchema *schema;
+	GSettingsSchemaSource *src = g_settings_schema_source_get_default();
+
+	/* a command line or per-uri DarkMode wins over the desktop */
+	if (!darkfollowsystem || defconfig[DarkMode].prio > 0 || !src)
+		return;
+	if (!(schema = g_settings_schema_source_lookup(src,
+	    "org.gnome.desktop.interface", TRUE)))
+		return;
+	if (g_settings_schema_has_key(schema, "color-scheme")) {
+		ifacesettings = g_settings_new("org.gnome.desktop.interface");
+		g_signal_connect(ifacesettings, "changed::color-scheme",
+		                 G_CALLBACK(colorschemechanged), NULL);
+		colorschemechanged(ifacesettings, "color-scheme", NULL);
+	}
+	g_settings_schema_unref(schema);
+}
