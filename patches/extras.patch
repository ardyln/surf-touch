+/* ---- extras: find bar, address focus, bookmarks (Wayland-friendly; X11 keeps dmenu) ---- */
+
+static void
+findsearch(GtkSearchEntry *e, Client *c)
+{
+	const char *t = gtk_entry_get_text(GTK_ENTRY(e));
+
+	if (*t)
+		webkit_find_controller_search(c->finder, t, findopts, G_MAXUINT);
+	else
+		webkit_find_controller_search_finish(c->finder);
+}
+
+static void
+findstep(GtkWidget *w, Client *c)
+{
+	int dir = GPOINTER_TO_INT(g_object_get_data(G_OBJECT(w), "dir"));
+
+	if (dir > 0)
+		webkit_find_controller_search_next(c->finder);
+	else if (dir < 0)
+		webkit_find_controller_search_previous(c->finder);
+	else
+		findbar(c, &(Arg){ .i = -1 });
+}
+
+static gboolean
+findkey(GtkWidget *w, GdkEventKey *e, Client *c)
+{
+	/* Enter = next, Shift+Enter = previous */
+	if (e->keyval == GDK_KEY_Return || e->keyval == GDK_KEY_KP_Enter) {
+		if (e->state & GDK_SHIFT_MASK)
+			webkit_find_controller_search_previous(c->finder);
+		else
+			webkit_find_controller_search_next(c->finder);
+		return TRUE;
+	}
+	return FALSE;
+}
+
+static GtkWidget *
+findbutton(Client *c, const char *label, int dir)
+{
+	GtkWidget *b = gtk_button_new_with_label(label);
+
+	gtk_widget_set_can_focus(b, FALSE);
+	g_object_set_data(G_OBJECT(b), "dir", GINT_TO_POINTER(dir));
+	g_signal_connect(b, "clicked", G_CALLBACK(findstep), c);
+	return b;
+}
+
+static GtkWidget *
+tbfindcreate(Client *c, GtkWidget *bar)
+{
+	GtkWidget *outer = gtk_box_new(GTK_ORIENTATION_VERTICAL, 0);
+
+	c->tbfind = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 2);
+	gtk_style_context_add_class(gtk_widget_get_style_context(c->tbfind), "surftb");
+	c->tbfindentry = gtk_search_entry_new();
+	gtk_entry_set_placeholder_text(GTK_ENTRY(c->tbfindentry), "find in page");
+	g_signal_connect(c->tbfindentry, "search-changed", G_CALLBACK(findsearch), c);
+	g_signal_connect(c->tbfindentry, "key-press-event", G_CALLBACK(findkey), c);
+	gtk_box_pack_start(GTK_BOX(c->tbfind), c->tbfindentry, TRUE, TRUE, 0);
+	gtk_box_pack_start(GTK_BOX(c->tbfind), findbutton(c, "▲", -1), FALSE, FALSE, 0);
+	gtk_box_pack_start(GTK_BOX(c->tbfind), findbutton(c, "▼", +1), FALSE, FALSE, 0);
+	gtk_box_pack_start(GTK_BOX(c->tbfind), findbutton(c, "✕", 0), FALSE, FALSE, 0);
+	gtk_widget_set_no_show_all(c->tbfind, TRUE);
+
+	gtk_box_pack_start(GTK_BOX(outer), bar, FALSE, FALSE, 0);
+	gtk_box_pack_start(GTK_BOX(outer), c->tbfind, FALSE, FALSE, 0);
+	return outer;
+}
+
+/* a->i < 0 closes the find bar, anything else opens it */
+void
+findbar(Client *c, const Arg *a)
+{
+	if (!c->tbfind)
+		return;
+	if (a && a->i < 0) {
+		webkit_find_controller_search_finish(c->finder);
+		gtk_widget_hide(c->tbfind);
+		gtk_widget_grab_focus(GTK_WIDGET(c->view));
+		return;
+	}
+	gtk_widget_show_all(c->tbfind);
+	gtk_widget_grab_focus(c->tbfindentry);
+	gtk_editable_select_region(GTK_EDITABLE(c->tbfindentry), 0, -1);
+}
+
+void
+focusaddress(Client *c, const Arg *a)
+{
+	if (!c->tburl)
+		return;
+	gtk_widget_grab_focus(c->tburl);
+	gtk_editable_select_region(GTK_EDITABLE(c->tburl), 0, -1);
+}
+
+/* Ctrl+G: dmenu prompt on X11, the touchbar address on Wayland */
+void
+go(Client *c, const Arg *a)
+{
+	if (isx11 || !c->tburl)
+		spawn(c, a);
+	else
+		focusaddress(c, a);
+}
+
+/* Ctrl+F, Ctrl+/: dmenu prompt on X11, the find bar on Wayland */
+void
+findprompt(Client *c, const Arg *a)
+{
+	if (isx11 || !c->tbfind)
+		spawn(c, a);
+	else
+		findbar(c, &(Arg){ .i = 0 });
+}
+
+/* bookmarks: one "uri<TAB>title" per line in bookmarkfile */
+static char **
+bmread(void)
+{
+	char *data = NULL, **lines;
+
+	if (!bookmarkfile || !*bookmarkfile ||
+	    !g_file_get_contents(bookmarkfile, &data, NULL, NULL))
+		return g_new0(char *, 1);
+	lines = g_strsplit(data, "\n", -1);
+	g_free(data);
+	return lines;
+}
+
+static int
+bmfind(char **lines, const char *uri)
+{
+	int i;
+	size_t n = strlen(uri);
+
+	for (i = 0; lines[i]; i++)
+		if (!strncmp(lines[i], uri, n) &&
+		    (lines[i][n] == '\t' || lines[i][n] == '\0'))
+			return i;
+	return -1;
+}
+
+void
+bookmarktoggle(Client *c, const Arg *a)
+{
+	const char *uri = geturi(c), *title = c->title ? c->title : "";
+	char **lines, *t, *out;
+	GString *s;
+	int i, at;
+
+	if (!uri || !*uri || !strcmp(uri, "about:blank") || !bookmarkfile || !*bookmarkfile)
+		return;
+	lines = bmread();
+	at = bmfind(lines, uri);
+	s = g_string_new(NULL);
+	for (i = 0; lines[i]; i++)
+		if (i != at && *lines[i])
+			g_string_append_printf(s, "%s\n", lines[i]);
+	if (at < 0) {
+		t = g_strdelimit(g_strdup(title), "\t\n", ' ');
+		g_string_append_printf(s, "%s\t%s\n", uri, t);
+		g_free(t);
+	}
+	out = g_string_free(s, FALSE);
+	g_file_set_contents(bookmarkfile, out, -1, NULL);
+	g_free(out);
+	g_strfreev(lines);
+}
+
+static void
+bmactivate(GtkMenuItem *m, Client *c)
+{
+	const char *cmd = g_object_get_data(G_OBJECT(m), "bmcmd");
+	Arg a = { .i = 0 };
+
+	if (!strcmp(cmd, "toggle")) {
+		bookmarktoggle(c, &a);
+	} else if (!strcmp(cmd, "find")) {
+		findbar(c, &a);
+		return;
+	} else {
+		a.v = cmd;
+		loaduri(c, &a);
+	}
+	gtk_widget_grab_focus(GTK_WIDGET(c->view));
+}
+
+static GtkWidget *
+bmitem(Client *c, GtkWidget *menu, const char *label, const char *cmd)
+{
+	GtkWidget *m = gtk_menu_item_new_with_label(label);
+
+	g_object_set_data_full(G_OBJECT(m), "bmcmd", g_strdup(cmd), g_free);
+	g_signal_connect(m, "activate", G_CALLBACK(bmactivate), c);
+	gtk_menu_shell_append(GTK_MENU_SHELL(menu), m);
+	return m;
+}
+
+void
+bookmarkmenu(Client *c, const Arg *a)
+{
+	GtkWidget *menu = gtk_menu_new(), *m;
+	const char *uri = geturi(c);
+	char **lines = bmread(), **f, *label;
+	int i, have = uri && bmfind(lines, uri) >= 0;
+
+	gtk_style_context_add_class(gtk_widget_get_style_context(menu), "surfmenu");
+	bmitem(c, menu, have ? "☆  Remove bookmark" : "★  Bookmark this page", "toggle");
+	if (c->tbfind)
+		bmitem(c, menu, "🔍  Find in page", "find");
+	gtk_menu_shell_append(GTK_MENU_SHELL(menu), gtk_separator_menu_item_new());
+	for (i = 0; lines[i]; i++) {
+		if (!*lines[i])
+			continue;
+		f = g_strsplit(lines[i], "\t", 2);
+		label = (f[1] && *f[1]) ? g_strdup(f[1]) : g_strdup(f[0]);
+		if (g_utf8_strlen(label, -1) > 48) {
+			char *cut = g_utf8_substring(label, 0, 47);
+			g_free(label);
+			label = g_strconcat(cut, "…", NULL);
+			g_free(cut);
+		}
+		m = bmitem(c, menu, label, f[0]);
+		gtk_widget_set_tooltip_text(m, f[0]);
+		g_free(label);
+		g_strfreev(f);
+	}
+	g_strfreev(lines);
+	gtk_widget_show_all(menu);
+	g_signal_connect(menu, "deactivate", G_CALLBACK(gtk_widget_destroy), NULL);
+	if (c->tbbar)
+		gtk_menu_popup_at_widget(GTK_MENU(menu), c->tbbar,
+		    touchbarbottom ? GDK_GRAVITY_NORTH_EAST : GDK_GRAVITY_SOUTH_EAST,
+		    touchbarbottom ? GDK_GRAVITY_SOUTH_EAST : GDK_GRAVITY_NORTH_EAST, NULL);
+	else
+		gtk_menu_popup_at_widget(GTK_MENU(menu), GTK_WIDGET(c->view),
+		    GDK_GRAVITY_CENTER, GDK_GRAVITY_CENTER, NULL);
+}
+
 
