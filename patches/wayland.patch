Description: run on Wayland natively when available
 The Debian force-x11 patch pins surf to X11 because a few features use
 Xlib directly. Make those X11-only (window properties for dmenu go/find,
 XEmbed via -e) and let GDK pick Wayland first. Fixes a crash on 32-bit
 systems where GTK3's X11 backend overflows the monitor refresh rate
 (reported as ~0 Hz) and WebKitGTK 2.54 divides by it.
 Set usewayland = 0 in config.h to keep X11.
Author: Ardy <https://github.com/ardyln>
Forwarded: not-needed
---
--- b/surf.c	2026-11-17 18:31:49.537564491 +0300
+++ c/surf.c	2026-11-17 18:41:50.461224236 +0300
@@ -252,6 +252,7 @@
 static int showxid;
 static int cookiepolicy;
 static Display *dpy;
+static int isx11; /* wayland: running on the X11 backend */
 static Client *clients;
 static GdkDevice *gdkkb;
 static char *stylefile;
@@ -341,19 +342,22 @@
 	if (signal(SIGHUP, sighup) == SIG_ERR)
 		die("Can't install SIGHUP handler");
 
-	if (!(dpy = XOpenDisplay(NULL)))
-		die("Can't open default display");
-
-	/* atoms */
-	atoms[AtomFind] = XInternAtom(dpy, "_SURF_FIND", False);
-	atoms[AtomGo] = XInternAtom(dpy, "_SURF_GO", False);
-	atoms[AtomUri] = XInternAtom(dpy, "_SURF_URI", False);
-	atoms[AtomUTF8] = XInternAtom(dpy, "UTF8_STRING", False);
-
-	gdk_set_allowed_backends("x11");
+	gdk_set_allowed_backends(usewayland ? "wayland,x11" : "x11");
 	gtk_init(NULL, NULL);
 
 	gdpy = gdk_display_get_default();
+	isx11 = GDK_IS_X11_DISPLAY(gdpy);
+
+	if (isx11) {
+		if (!(dpy = XOpenDisplay(NULL)))
+			die("Can't open default display");
+
+		/* atoms */
+		atoms[AtomFind] = XInternAtom(dpy, "_SURF_FIND", False);
+		atoms[AtomGo] = XInternAtom(dpy, "_SURF_GO", False);
+		atoms[AtomUri] = XInternAtom(dpy, "_SURF_URI", False);
+		atoms[AtomUTF8] = XInternAtom(dpy, "UTF8_STRING", False);
+	}
 
 	curconfig = defconfig;
 
@@ -618,6 +622,8 @@
 void
 setatom(Client *c, int a, const char *v)
 {
+	if (!isx11)
+		return;
 	XChangeProperty(dpy, c->xid,
 	                atoms[a], atoms[AtomUTF8], 8, PropModeReplace,
 	                (unsigned char *)v, strlen(v) + 1);
@@ -633,6 +639,8 @@
 	unsigned long ldummy;
 	unsigned char *p = NULL;
 
