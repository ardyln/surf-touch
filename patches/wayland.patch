+		return "";
 	XSync(dpy, False);
 	XGetWindowProperty(dpy, c->xid,
 	                   atoms[a], 0L, BUFSIZ, False, atoms[AtomUTF8],
@@ -1101,7 +1109,8 @@
 	g_free(scriptfile);
 	g_free(stylefile);
 	g_free(cachedir);
-	XCloseDisplay(dpy);
+	if (dpy)
+		XCloseDisplay(dpy);
 }
 
 WebKitWebView *
