+/* ---- header bar mode: GNOME Web-like title bar ---- */
+
+static GtkWidget *
+tbicon(Client *c, const char *icon, const char *tip, const char *cmd)
+{
+	GtkWidget *b = gtk_button_new_from_icon_name(icon, GTK_ICON_SIZE_LARGE_TOOLBAR);
+
+	gtk_widget_set_can_focus(b, FALSE);
+	gtk_widget_set_valign(b, GTK_ALIGN_CENTER);
+	gtk_widget_set_tooltip_text(b, tip);
+	g_object_set_data(G_OBJECT(b), "tbcmd", (gpointer)cmd);
+	g_signal_connect(b, "clicked", G_CALLBACK(tbclicked), c);
+	return b;
+}
+
+static void
+tbmenuitem(Client *c, GtkWidget *box, const char *text, const char *cmd)
+{
+	GtkWidget *b = gtk_model_button_new(); /* closes the menu when tapped */
+
+	g_object_set(b, "text", text, NULL);
+	g_object_set_data(G_OBJECT(b), "tbcmd", (gpointer)cmd);
+	g_signal_connect(b, "clicked", G_CALLBACK(tbclicked), c);
+	gtk_box_pack_start(GTK_BOX(box), b, FALSE, FALSE, 0);
+}
+
+/* the ☰ menu: zoom row and fullscreen like GNOME Web, then the commands */
+static GtkWidget *
+tbmenu(Client *c, GtkWidget *relative)
+{
+	GtkWidget *pop = gtk_popover_new(relative);
+	GtkWidget *box = gtk_box_new(GTK_ORIENTATION_VERTICAL, 0);
+	GtkWidget *row = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 6);
+	GtkWidget *zoom = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 0);
+
+	gtk_style_context_add_class(gtk_widget_get_style_context(pop), "surfpop");
+	g_object_set(box, "margin", 6, NULL);
+	gtk_style_context_add_class(gtk_widget_get_style_context(zoom), "linked");
+	gtk_box_pack_start(GTK_BOX(zoom),
+	    tbicon(c, "zoom-out-symbolic", "Zoom out", "zout"), TRUE, TRUE, 0);
+	c->tbzoom = gtk_button_new_with_label("100%");
+	gtk_widget_set_tooltip_text(c->tbzoom, "Reset zoom");
+	gtk_widget_set_can_focus(c->tbzoom, FALSE);
+	g_object_set_data(G_OBJECT(c->tbzoom), "tbcmd", (gpointer)"zreset");
+	g_signal_connect(c->tbzoom, "clicked", G_CALLBACK(tbclicked), c);
+	gtk_box_pack_start(GTK_BOX(zoom), c->tbzoom, TRUE, TRUE, 0);
+	gtk_box_pack_start(GTK_BOX(zoom),
+	    tbicon(c, "zoom-in-symbolic", "Zoom in", "zin"), TRUE, TRUE, 0);
+	gtk_box_pack_start(GTK_BOX(row), zoom, TRUE, TRUE, 0);
+	if (touchfullscreen)
+		gtk_box_pack_start(GTK_BOX(row),
+		    tbicon(c, "view-fullscreen-symbolic", "Fullscreen", "full"),
+		    FALSE, FALSE, 0);
+	gtk_box_pack_start(GTK_BOX(box), row, FALSE, FALSE, 0);
+	gtk_box_pack_start(GTK_BOX(box),
+	    gtk_separator_new(GTK_ORIENTATION_HORIZONTAL), FALSE, FALSE, 6);
+	tbmenuitem(c, box, "New Window", "new");
+	tbmenuitem(c, box, "Find in Page…", "find");
+	tbmenuitem(c, box, "Home Page", "home");
+	gtk_widget_show_all(box);
+	gtk_container_add(GTK_CONTAINER(pop), box);
+	return pop;
+}
+
+static void
+tbstarpress(GtkEntry *e, GtkEntryIconPosition pos, GdkEvent *ev, Client *c)
+{
+	bookmarktoggle(c, NULL);
+}
+
+/* the star in the address entry shows whether this page is bookmarked */
+void
+tbstar(Client *c, int force)
+{
+	const char *uri = geturi(c);
+	char **lines;
+	int have;
+
+	if (!tbheader || !c->tburl || !bookmarkfile || !*bookmarkfile)
+		return;
+	if (!force && c->tbstaruri && uri && !strcmp(c->tbstaruri, uri))
+		return;
+	g_free(c->tbstaruri);
+	c->tbstaruri = g_strdup(uri ? uri : "");
+	lines = bmread();
+	have = uri && bmfind(lines, uri) >= 0;
+	g_strfreev(lines);
+	gtk_entry_set_icon_from_icon_name(GTK_ENTRY(c->tburl),
+	    GTK_ENTRY_ICON_SECONDARY, have ? "starred-symbolic" : "non-starred-symbolic");
+	gtk_entry_set_icon_tooltip_text(GTK_ENTRY(c->tburl), GTK_ENTRY_ICON_SECONDARY,
+	    have ? "Remove bookmark" : "Bookmark this page");
+}
+
+static GtkWidget *
+tbheadercreate(Client *c)
+{
+	GtkWidget *hb = gtk_header_bar_new(), *mb;
+
+	gtk_header_bar_set_show_close_button(GTK_HEADER_BAR(hb), TRUE);
+	gtk_style_context_add_class(gtk_widget_get_style_context(hb), "surftb");
+
+	c->tbback = tbicon(c, "go-previous-symbolic", "Back", "back");
+	c->tbfwd = tbicon(c, "go-next-symbolic", "Forward", "fwd");
+	c->tbreload = tbicon(c, "view-refresh-symbolic", "Reload", "reload");
+	gtk_header_bar_pack_start(GTK_HEADER_BAR(hb), c->tbback);
+	gtk_header_bar_pack_start(GTK_HEADER_BAR(hb), c->tbfwd);
+	gtk_header_bar_pack_start(GTK_HEADER_BAR(hb), c->tbreload);
+
+	c->tburl = gtk_entry_new();
+	gtk_entry_set_input_purpose(GTK_ENTRY(c->tburl), GTK_INPUT_PURPOSE_URL);
+	gtk_entry_set_placeholder_text(GTK_ENTRY(c->tburl), "Search or enter address");
+	gtk_entry_set_width_chars(GTK_ENTRY(c->tburl), 12);
+	gtk_widget_set_hexpand(c->tburl, TRUE);
+	g_signal_connect(c->tburl, "activate", G_CALLBACK(tbactivate), c);
+	g_signal_connect(c->tburl, "focus-in-event", G_CALLBACK(tburlfocus), c);
+	if (bookmarkfile && *bookmarkfile) {
+		gtk_entry_set_icon_from_icon_name(GTK_ENTRY(c->tburl),
+		    GTK_ENTRY_ICON_SECONDARY, "non-starred-symbolic");
+		g_signal_connect(c->tburl, "icon-press", G_CALLBACK(tbstarpress), c);
+	}
+	gtk_header_bar_set_custom_title(GTK_HEADER_BAR(hb), c->tburl);
+
+	/* pack_end: first one is rightmost */
+	mb = gtk_menu_button_new();
+	gtk_widget_set_can_focus(mb, FALSE);
+	gtk_widget_set_valign(mb, GTK_ALIGN_CENTER);
+	gtk_widget_set_tooltip_text(mb, "Menu");
+	gtk_button_set_image(GTK_BUTTON(mb), gtk_image_new_from_icon_name(
+	    "open-menu-symbolic", GTK_ICON_SIZE_LARGE_TOOLBAR));
+	gtk_menu_button_set_popover(GTK_MENU_BUTTON(mb), tbmenu(c, mb));
+	gtk_header_bar_pack_end(GTK_HEADER_BAR(hb), mb);
+	if (bookmarkfile && *bookmarkfile)
+		gtk_header_bar_pack_end(GTK_HEADER_BAR(hb),
+		    tbicon(c, "user-bookmarks-symbolic", "Bookmarks", "bm"));
+	c->tbhead = hb;
+	return hb;
+}
